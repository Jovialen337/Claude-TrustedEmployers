# Nøkkel til Claude API. Brukes BARE til å lese dokumenter (PDF/bilde) og gjøre dem om
# til strukturerte data. Appen fungerer helt fint uten nøkkel — da fyller du inn selv,
# eller bruker demodataene.
#
# Kopier denne fila til .env og lim inn din egen nøkkel:
#   cp .env.example .env
ANTHROPIC_API_KEY=

# Modell som brukes til uthenting av data fra dokumenter.
ANTHROPIC_MODEL=claude-opus-5

# Hvor lokale data lagres (relativt til prosjektmappa). Standard: .data
LONNSSJEKK_DATA_DIR=.data
